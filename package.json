{
  "name": "nodokan",
  "private": true,
  "scripts": {
    "build": "node esbuild.build.mjs",
    "lint": "eslint ./app/javascript/**/*.civet",
    "build:css": "sass ./app/assets/stylesheets/:./app/assets/builds/ --no-source-map --load-path=node_modules --silence-deprecation=import --silence-deprecation=global-builtin --silence-deprecation=color-functions --silence-deprecation=if-function",
    "lint:css": "stylelint ./app/assets/stylesheets/"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.9",
    "bootstrap-icons": "^1.13.2",
    "hyperapp": "^2.0.22",
    "ipaddr.js": "^2.5.0",
    "rails_admin": "4.0.0-beta2"
  },
  "devDependencies": {
    "@danielx/civet": "^0.11.16",
    "@eslint/js": "^10.0.1",
    "@types/bootstrap": "^5.2.11",
    "@types/hotwired__turbo": "^8.0.16",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-civet": "^0.1.0",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "postcss-sass": "^0.5.0",
    "sass": "^1.108.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2"
  }
}
